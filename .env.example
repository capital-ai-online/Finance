# Konfigurationsquellen (Stand 22.08.2026)
# ----------------------------------------
# Produktion (Render):
#   - Echte Secrets kommen aus der Secret File `finance-secrets.env`, die Render read-only unter
#     /etc/secrets/ mountet und die zur Laufzeit von server/env.ts geladen wird. Welche Schluessel
#     dort liegen, definiert ausschliesslich scripts/security/secretFileManifest.ts.
#   - Nicht-vertrauliche Werte (VITE_*, Publishable/Anon-Keys, OAuth-Client-IDs, Price-IDs) bleiben
#     normale Render-`envVars` (siehe render.yaml).
#   - VITE_*-Werte werden von Vite zur BUILD-Zeit eingesetzt und muessen daher im Dockerfile als
#     ARG/ENV deklariert sein - eine Secret File steht zur Build-Zeit nicht zur Verfuegung.
# Lokal/CI: diese Datei als Vorlage nach .env kopieren; .env ist gitignored.

# Produktion: Teil der Secret File `finance-secrets.env`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ADR-0088/ADR-0089/ADR-0090 — Gemini Research Evidence Shadow (server-only, Free-Tier-only).
GEMINI_API_KEY=
GEMINI_RESEARCH_SHADOW_ENABLED=false
GEMINI_RESEARCH_FREE_TIER_ONLY=true
GEMINI_RESEARCH_FREE_TIER_ATTESTED=false
GEMINI_RESEARCH_REQUESTS_PER_MINUTE=3
GEMINI_RESEARCH_DAILY_REQUEST_BUDGET=50
GEMINI_RESEARCH_DAILY_TOKEN_BUDGET=250000
GEMINI_RESEARCH_TIMEOUT_MS=8000
GEMINI_RESEARCH_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_RESEARCH_CIRCUIT_COOLDOWN_MS=60000
GEMINI_RESEARCH_MAX_OUTPUT_TOKENS=1200
GEMINI_RESEARCH_THINKING_LEVEL=low

APP_URL="MY_APP_URL"

# Supabase Integration Variables
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# Google Analytics 4 Measurement-ID
VITE_GA_MEASUREMENT_ID=

# Existing market/macro providers — server-side only.
ALPHA_VANTAGE_KEY=
COIN_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# ADR-0100 DeFiLlama — keyless free public evidence path.
DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true
# DEFILLAMA_API_KEY is intentionally not used by the current canonical provider.

# SC-4 Dune — Free-Tier-only, read-only latest saved-query results.
# DUNE_API_KEY is a secret; all other DUNE_* values below are governance configuration.
DUNE_API_KEY=
DUNE_FREE_TIER_ONLY=true
DUNE_FREE_TIER_ATTESTED=false
DUNE_ALLOWED_QUERY_IDS=
DUNE_MAX_RESULT_ROWS=25

# SC-4 keyless/free providers require no secrets:
# GoPlus public Security API, GDELT DOC 2.0, Kraken Futures Public Charts,
# DEX Screener public API, Sourcify API v2 and DeFiLlama public API.
# NEWS_API_KEY / COINGLASS_API_KEY / LUNARCRUSH_API_KEY / MESSARI_API_KEY are not used.

# TOTP-Verschlüsselung
TOTP_ENCRYPTION_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"

# ADR-0020 Social Media Direct Publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Alpaca Market Data (server-side, read-only Shadow Mode)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
