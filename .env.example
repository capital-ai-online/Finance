# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Integration Variables
# NOTE: VITE_* environment variables are baked in by Vite at BUILD-TIME (e.g., during Render or Docker builds) and are NOT dynamically injected at runtime. Make sure to define these in the builder environment.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe / Supabase Price IDs for Subscription Tiers
# Supports both STRIPE_PRICE_ID_* and SUPABASE_PRICE_ID_* prefixes, with monthly/yearly suffixes:
SUPABASE_PRICE_ID_STARTER_MONTHLY="price_..."
SUPABASE_PRICE_ID_STARTER_YEARLY="price_..."
SUPABASE_PRICE_ID_PRO_MONTHLY="price_..."
SUPABASE_PRICE_ID_PRO_YEARLY="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# One-time payment price ID for PDF exports
STRIPE_EXPORT_PDF="price_..."

# Alpha Vantage API Key
ALPHA_VANTAGE_KEY=

# News API Key (NewsAPI.org or dynamic simulation key)
NEWS_API_KEY=
News_API_KEy=

# CoinMarketCap API Key for live crypto price feeds
COINMARKETCAP_API_KEY=

# Kraken API Keys
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
API_KEY=
API_SECRET=

# Orchestrator Admin Passcode/Token
ORCHESTRATOR_ADMIN_TOKEN=

