# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY / OPENAI_API_KEY (J3, J4): zusaetzliche Provider fuer den Modell-Rueckfall
# (agentModelRouting.ts) und - fuer OPENAI_API_KEY - fuer die RAG-Embeddings
# (src/services/rag/embeddingsClient.ts, `npm run rag:build-index`). Beide optional; ohne sie
# bleibt die jeweilige Stufe fail-open inaktiv.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADR-0009 CORS Hardening: Google AI Studio Origin (nur Entwicklung).
# Ausschließlich für die Entwicklungsumgebung, wird ignoriert wenn NODE_ENV=production.
# Beispiel: https://ai.studio (oder die konkrete Cloud-Run-Preview-URL der Session)
AI_STUDIO_ORIGIN=

# Supabase Integration Variables
# NOTE: VITE_* environment variables are baked in by Vite at BUILD-TIME (e.g., during Render or Docker builds) and are NOT dynamically injected at runtime. Make sure to define these in the builder environment.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# Alpha Vantage API Key
ALPHA_VANTAGE_KEY=

# ADR-0021 Market-Data-Provider — ausschließlich serverseitig verwenden.
# Keine dieser Variablen darf ein VITE_-Prefix erhalten oder an Browser-Code ausgegeben werden.
COIN_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=

# News API Key (NewsAPI.org or dynamic simulation key)
NEWS_API_KEY=
News_API_KEy=

# CoinMarketCap API Key for live crypto price feeds
COINMARKETCAP_API_KEY=

# Kraken API Keys
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
API_KEY=
API_SECRET=

# ORCHESTRATOR_ADMIN_TOKEN wurde entfernt (ADR-0003.5): der Token+Hardcoded-Fallback-
# Mechanismus, den diese Variable steuerte, ist durch die einheitliche JWT-basierte
# checkAdminAccess()-Prüfung ersetzt worden. Kein Ersatzwert nötig.

# TOTP-Verschlüsselung (ADR-0003.5 Step-Up-Authentication)
# 32 Byte / 64 Hex-Zeichen. Generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WICHTIG: Ohne diesen Wert schlägt jede TOTP-Verschlüsselung/-Entschlüsselung fehl (fail-closed).
# Bei Rotation dieses Schlüssels werden bestehende TOTP-Secrets unlesbar - betroffene Nutzer
# müssen 2FA neu einrichten.
TOTP_ENCRYPTION_KEY=

# SMTP (support@capital-ai.online) - fuer System-E-Mails wie Abo-Aktivierungs-Bestätigungen.
# SMTP_PORT 587 = STARTTLS (empfohlen), 465 = implizites TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"

# ADR-0020 Social Media Direct Publishing — OAuth-2.0-Client-Credentials pro Plattform.
# Ohne gesetztes Client-ID/Secret-Paar bleibt die jeweilige Plattform in
# /api/social-media/auth/url mit HTTP 503 gesperrt (fail-closed, kein Fallback).
# Setup-Anleitung je Plattform: docs/runbooks/SOCIAL_MEDIA_OAUTH_SETUP.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

