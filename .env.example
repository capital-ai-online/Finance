# Konfigurationsquellen (Stand 23.08.2026)
# ----------------------------------------
# Produktion (Render): echte Secrets kommen ausschließlich aus finance-secrets.env.
# Nicht-vertrauliche Governance-/Runtime-Werte bleiben normale Render envVars.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ADR-0088/ADR-0089/ADR-0090 — Gemini Research Evidence Shadow.
# Ein zweiter GEMINI_API_KEY im selben Google-Cloud-Projekt erhöht keine Free-Tier-Quota, da
# Gemini-Limits projektbezogen sind. Der bestehende Key bleibt die kanonische Secret-Authority.
GEMINI_API_KEY=
GEMINI_RESEARCH_SHADOW_ENABLED=false
GEMINI_RESEARCH_FREE_TIER_ONLY=true
GEMINI_RESEARCH_FREE_TIER_ATTESTED=false
GEMINI_RESEARCH_REQUESTS_PER_MINUTE=3
GEMINI_RESEARCH_DAILY_REQUEST_BUDGET=50
GEMINI_RESEARCH_DAILY_TOKEN_BUDGET=250000
GEMINI_RESEARCH_TIMEOUT_MS=8000
GEMINI_RESEARCH_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_RESEARCH_CIRCUIT_COOLDOWN_MS=60000
GEMINI_RESEARCH_MAX_OUTPUT_TOKENS=1200
GEMINI_RESEARCH_THINKING_LEVEL=low

APP_URL="MY_APP_URL"

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

VITE_GA_MEASUREMENT_ID=

# Existing market/macro providers — server-side only.
ALPHA_VANTAGE_KEY=
COIN_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# ADR-0101 Commodity P0/P1 — official fundamentals/evidence adapters.
# Both keys are server-side secrets and must never be exposed via VITE_* variables.
# CFTC COT, USGS MCS and EU CRMA evidence are public/keyless; no secret is required.
EIA_API_KEY=
USDA_FAS_API_KEY=

# ADR-0100 DeFiLlama — keyless free public evidence path.
DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true

# SC-4 primary crypto market suppliers are keyless Binance Public + Kraken Public.
# Exact exchange market symbols come from CryptoEvidenceIdentityRegistry, never from user input.

# SC-4 Dune — read-only governed saved-query results.
# DUNE_API_KEY is a secret and belongs in finance-secrets.env; never commit a real value here.
DUNE_API_KEY=
# FREE_TIER = permanent bounded free access; TRIAL_14D = Owner-attested temporary broader dataset entitlement.
DUNE_ACCESS_MODE=FREE_TIER
DUNE_FREE_TIER_ATTESTED=false
DUNE_TRIAL_ATTESTED=false
DUNE_TRIAL_STARTED_AT=
DUNE_TRIAL_ENDS_AT=
# Semantic query variables are the only numeric query-ID authority; the provider derives its
# allowlist automatically. Keep unverified/custom queries empty.
DUNE_QUERY_AAVE_ACTIVE_ADDRESSES=5833540
DUNE_QUERY_AAVE_TREASURY=27230
DUNE_QUERY_AAVE_ORACLE_RAW=
DUNE_QUERY_AAVE_ADDRESS_RETENTION=
DUNE_QUERY_AAVE_TOKEN_EMISSIONS=
DUNE_QUERY_AAVE_LP_CONCENTRATION=
DUNE_MAX_RESULT_ROWS=25

# SC-4 keyless/free specialist providers require no secrets:
# GoPlus public Security API, GDELT DOC 2.0, Binance Public Spot/Futures,
# Kraken Public/Futures, DEX Screener public API, Sourcify API v2, DeFiLlama public API.
# NEWS_API_KEY / COINGLASS_API_KEY / LUNARCRUSH_API_KEY / MESSARI_API_KEY are not used.

TOTP_ENCRYPTION_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"

# Social OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Alpaca Market Data (server-side, read-only Shadow Mode)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# GitGuardian-Honeytoken (Decoy-Credential, ADR-0067 / Sicherheitsreport 2026-08-26)
# Das Token wird AUSSERHALB der Anwendung im GitGuardian-Dashboard erzeugt und hier nur gelesen.
# Die Anwendung erzeugt, rotiert oder loescht keine Honeytokens - die Runbook-Vorgabe, der
# GitGuardian-App keine Honeytoken-Schreibrechte zu erteilen, bleibt damit unveraendert gueltig.
# Alle drei Werte muessen gemeinsam gesetzt sein; unvollstaendige Konfiguration deaktiviert den
# Tripwire fail-closed, statt mit einem nie ausloesenden Token weiterzulaufen.
# Siehe docs/runbooks/GITGUARDIAN_SNYK_APP_INTEGRATION.md
GITGUARDIAN_HONEYTOKEN_ID=
GITGUARDIAN_HONEYTOKEN_AKID=
GITGUARDIAN_HONEYTOKEN_SECRET=
