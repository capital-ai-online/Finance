# Konfigurationsquellen (Stand 08.08.2026)
# ----------------------------------------
# Produktion (Render):
#   - Echte Secrets kommen aus der Secret File `finance-secrets.env`, die Render read-only unter
#     /etc/secrets/ mountet und die zur Laufzeit von server/env.ts geladen wird. Welche Schluessel
#     dort liegen, definiert ausschliesslich scripts/security/secretFileManifest.ts.
#   - Nicht-vertrauliche Werte (VITE_*, Publishable/Anon-Keys, OAuth-Client-IDs, Price-IDs) bleiben
#     normale Render-`envVars` (siehe render.yaml).
#   - VITE_*-Werte werden von Vite zur BUILD-Zeit eingesetzt und muessen daher im Dockerfile als
#     ARG/ENV deklariert sein - eine Secret File steht zur Build-Zeit nicht zur Verfuegung.
# Lokal/CI: diese Datei als Vorlage nach .env kopieren; .env ist gitignored.
#
# Google AI Studio wird nicht mehr als Entwicklungsumgebung verwendet. Frueher hier dokumentierte
# automatische Injektionen durch AI Studio gelten nicht mehr; alle Werte werden wie oben gesetzt.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Produktion: Teil der Secret File `finance-secrets.env`.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY / OPENAI_API_KEY (J3, J4): zusaetzliche Provider fuer den Modell-Rueckfall
# (agentModelRouting.ts) und - fuer OPENAI_API_KEY - fuer die RAG-Embeddings
# (src/services/rag/embeddingsClient.ts, `npm run rag:build-index`). Beide optional; ohne sie
# bleibt die jeweilige Stufe fail-open inaktiv.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Produktion: https://capital-ai.online
APP_URL="MY_APP_URL"

# ADR-0009 CORS Hardening: zusaetzlich erlaubter Origin (nur Entwicklung).
# VERALTET: diese Variable existierte fuer die frueher genutzte Google-AI-Studio-Entwicklungs-
# umgebung, die nicht mehr verwendet wird. Sie wird in Produktion ohnehin ignoriert
# (NODE_ENV=production) und sollte leer bleiben. Der vollstaendige Ausbau aus
# server.application.ts und server/middleware/cors.ts ist als Q6 in
# docs/seo/SEO_MANAGEMENT_ROADMAP.md terminiert und benoetigt einen Nachtrag zu ADR-0009.
AI_STUDIO_ORIGIN=

# Supabase Integration Variables
# NOTE: VITE_* environment variables are baked in by Vite at BUILD-TIME (e.g., during Render or Docker builds) and are NOT dynamically injected at runtime. Make sure to define these in the builder environment.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# Google Analytics 4 Measurement-ID (siehe docs/runbooks/GOOGLE_ANALYTICS_SETUP.md).
# Oeffentlich sichtbar im HTML-Quelltext, kein Secret. Ohne diesen Wert bleibt GA4 deaktiviert
# (fail-closed) - es gibt keinen funktionierenden Tracking-Fallback ohne echte ID. Das Skript
# wird zusaetzlich clientseitig erst nach aktivem Cookie-Opt-in geladen (CookieConsentBanner).
VITE_GA_MEASUREMENT_ID=

# Alpha Vantage API Key
ALPHA_VANTAGE_KEY=

# ADR-0021 Market-Data-Provider — ausschließlich serverseitig verwenden.
# Keine dieser Variablen darf ein VITE_-Prefix erhalten oder an Browser-Code ausgegeben werden.
COIN_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=

# Macro-/Rate-Evidence (serverseitig). FRED benötigt einen API-Key; die ECB Data API ist keyless.
# FRED bleibt fail-closed, solange dieser Key nicht gesetzt ist.
FRED_API_KEY=

# News API Key (NewsAPI.org or dynamic simulation key)
NEWS_API_KEY=

# ORCHESTRATOR_ADMIN_TOKEN wurde entfernt (ADR-0003.5): der Token+Hardcoded-Fallback-
# Mechanismus, den diese Variable steuerte, ist durch die einheitliche JWT-basierte
# checkAdminAccess()-Prüfung ersetzt worden. Kein Ersatzwert nötig.

# TOTP-Verschlüsselung (ADR-0003.5 Step-Up-Authentication)
# 32 Byte / 64 Hex-Zeichen. Generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WICHTIG: Ohne diesen Wert schlägt jede TOTP-Verschlüsselung/-Entschlüsselung fehl (fail-closed).
# Bei Rotation dieses Schlüssels werden bestehende TOTP-Secrets unlesbar - betroffene Nutzer
# müssen 2FA neu einrichten.
TOTP_ENCRYPTION_KEY=

# SMTP (support@capital-ai.online) - fuer System-E-Mails wie Abo-Aktivierungs-Bestätigungen.
# SMTP_PORT 587 = STARTTLS (empfohlen), 465 = implizites TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"

# ADR-0020 Social Media Direct Publishing — OAuth-2.0-Client-Credentials pro Plattform.
# Ohne gesetztes Client-ID/Secret-Paar bleibt die jeweilige Plattform in
# /api/social-media/auth/url mit HTTP 503 gesperrt (fail-closed, kein Fallback).
# Setup-Anleitung je Plattform: docs/runbooks/SOCIAL_MEDIA_OAUTH_SETUP.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

