# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (e.g. https://finance-7clq.onrender.com)
APP_URL="MY_APP_URL"

# Supabase (REQUIRED for login/auth — both client AND server need these)
# Set under: Supabase Dashboard -> Project Settings -> API Keys
# IMPORTANT: VITE_* variables are baked into the frontend bundle at BUILD
# TIME by Vite. They must be available as Docker build ARGs (see Dockerfile)
# in addition to being set as normal runtime env vars on Render — otherwise
# the deployed login screen will keep asking for these two variables even
# though they are set in the Render dashboard.
#
# Supabase introduced a NEW key format (sb_publishable_... / sb_secret_...)
# that replaces the legacy JWT anon/service_role keys. If you disable the
# legacy keys in the Supabase dashboard, the old VITE_SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY JWTs stop working immediately and every request
# fails with "Invalid API key" — even though the JWT itself looks valid.
# Use the NEW keys below; the old ones are kept only as a fallback in code.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy fallback — only needed if you have NOT migrated to the new key format:
VITE_SUPABASE_ANON_KEY=""
# Server-only, used for privileged Supabase access (quota enforcement, admin checks)
SUPABASE_SECRET_KEY="sb_secret_..."
# Legacy fallback — only needed if you have NOT migrated to the new key format:
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_live_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# Alpha Vantage API Key (server-side only, never exposed to the client)
ALPHA_VANTAGE_KEY=

# NewsAPI.org API Key (server-side only). If unset, /api/news returns
# NOT_IMPLEMENTED/501 — it will NEVER fabricate news as a fallback.
NEWS_API_KEY=

# CoinMarketCap API Key (server-side only, freemium: 300 requests/day).
# Supplemental crypto source, exposed at GET /api/coinmarketcap/quotes —
# does NOT replace CoinGecko in /api/market-data. Server caches responses
# for 5 minutes to conserve the daily quota. If unset, the endpoint
# returns NOT_IMPLEMENTED/501.
COINMARKETCAP_API_KEY=

# Kraken and Binance public ticker endpoints require NO API key — they are
# used only for source_integrity cross-validation of BTC/ETH prices inside
# /api/market-data (see crossValidateCryptoSources in server.ts).

# DATA_INTEGRITY_MODE is NOT an env var — it is a hardcoded, frozen
# constant in src/lib/dataIntegrity.ts and must never be controlled via
# environment variables (that would make the No-Demo-Data policy
# configurable, which defeats its purpose).
