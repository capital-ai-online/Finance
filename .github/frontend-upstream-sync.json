{
  "schemaVersion": "1.2.0",
  "policyId": "CAPITAL-AI-FE-UPSTREAM-PRESENTATION-SYNC-01",
  "source": {
    "repository": "SvenKulessa/FRONTEND",
    "cloneUrl": "https://github.com/SvenKulessa/FRONTEND.git",
    "ref": "main"
  },
  "destination": "docs/frontend/upstream-source/SvenKulessa-FRONTEND",
  "architectureRoots": [
    "src/App.tsx",
    "src/main.tsx",
    "src/index.css",
    "src/types.ts"
  ],
  "visualFixtureExactPaths": [
    "src/data/mockData.ts",
    "src/data/assets/indexAssets.ts",
    "src/data/assets/cryptoAssets.ts",
    "src/data/assets/stockAssets.ts",
    "src/data/assets/forexAssets.ts",
    "src/data/assets/commodityAssets.ts"
  ],
  "allowedExactPaths": [
    "src/App.tsx",
    "src/main.tsx",
    "src/index.css",
    "src/types.ts",
    "src/data/mockData.ts",
    "src/data/assets/indexAssets.ts",
    "src/data/assets/cryptoAssets.ts",
    "src/data/assets/stockAssets.ts",
    "src/data/assets/forexAssets.ts",
    "src/data/assets/commodityAssets.ts",
    "src/context/PriceAlertsContext.tsx",
    "src/utils/priceAlerts.ts"
  ],
  "allowedPathPatterns": [
    "^src/components/.+\\.(?:tsx|ts|css|svg|png|jpe?g|webp|avif|gif)$",
    "^src/features/[^/]+/ui/.+\\.(?:tsx|ts|css|svg|png|jpe?g|webp|avif|gif)$",
    "^src/shared/(?:ui|branding|visuals)/.+\\.(?:tsx|ts|css|svg|png|jpe?g|webp|avif|gif)$",
    "^src/assets/(?:images/)?[^/].+\\.(?:svg|png|jpe?g|webp|avif|gif)$"
  ],
  "neverCopyPathPatterns": [
    "(?:^|/)services?(?:/|$)",
    "(?:^|/)api(?:/|$)",
    "(?:^|/)server(?:/|$)",
    "(?:^|/)auth(?:/|$)",
    "(?:^|/)billing(?:/|$)",
    "(?:^|/)scoring(?:/|$)",
    "(?:^|/)entitlements?(?:/|$)",
    "(?:^|/)providers?(?:/|$)",
    "(?:^|/)package(?:-lock)?\\.json$",
    "(?:^|/)vite\\.config\\.",
    "(?:^|/)\\.env"
  ],
  "promotionBlockContentPatterns": [
    "\\bfetch\\s*\\(",
    "\\baxios\\b",
    "\\bsupabase\\b",
    "\\bstripe\\b",
    "\\/api\\/",
    "\\bScoringDispatcher\\b",
    "\\bentitlements?\\b",
    "@google/genai",
    "process\\.env",
    "import\\.meta\\.env",
    "(?:^|/)data/mockData"
  ],
  "textExtensions": [
    ".tsx",
    ".ts",
    ".css",
    ".svg"
  ],
  "binaryExtensions": [
    ".png",
    ".jpg",
    ".jpeg",
    ".webp",
    ".avif",
    ".gif"
  ],
  "maxFileBytes": 5242880,
  "maxTotalBytes": 26214400,
  "runtimePromotion": {
    "automatic": false,
    "destinationUnderSrcAllowed": false,
    "adapterReviewRequired": true,
    "financeComponentsBindAfterArchitectureAdoption": true,
    "responsiveAdapterRequired": true,
    "previewShellDesktopPromotionAllowed": false,
    "devicePolicy": {
      "mobile": "preserve-current-source-behavior",
      "tablet": "preserve-current-source-behavior",
      "desktop": "finance-website-adapter-required"
    }
  },
  "responsiveRuntimeAdapter": {
    "required": true,
    "path": "src/features/public/ui/frontend-port/frontend-port.css",
    "validationTest": "tests/unit/frontendDesktopResponsiveAdapter.test.ts",
    "strategy": "DESKTOP_VIEWPORT_ADAPTER",
    "desktopMinPx": 1024,
    "preserveMobileSourceLayout": true,
    "preserveTabletSourceLayout": true,
    "upstreamPreviewChromeRuntimeOnDesktop": false,
    "userAgentBranching": false,
    "sourceLayoutMarkers": [
      "viewMode",
      "'mockup'",
      "'fullscreen'",
      "sm:max-w-[412px]",
      "max-w-md",
      "hidden sm:flex"
    ]
  },
  "interactionFixtureExactPaths": [
    "src/context/PriceAlertsContext.tsx",
    "src/utils/priceAlerts.ts"
  ],
  "intentionalUnmirroredRelativeDependencies": [
    "src/utils/analytics.ts",
    "src/data/vocabularyData.ts"
  ]
}
