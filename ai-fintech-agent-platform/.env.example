# ==========================================
# AI AGENT FINTECH ORCHESTRATION PLATFORM V2
# Environment Variables Example Configuration
# ==========================================

# Port configuration
PORT=3000

# Server Environment
NODE_ENV=development

# LLM Gateway API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Redis Cache and Rate Limiting
REDIS_URL=redis://localhost:6379

# Event Bus Provider (nats | kafka | memory)
EVENT_BUS_PROVIDER=memory
NATS_URL=nats://localhost:4222

# Security & OIDC (JSON Web Tokens)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars
OIDC_ISSUER_URL=https://auth.enterprise-fintech.com

# Compliance & Auditing
AUDIT_LOG_DIRECTORY=./logs/audit
HUMAN_IN_THE_LOOP_APPROVAL_THRESHOLD=70
