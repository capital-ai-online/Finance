{
  "name": "capital-ai",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.6.7",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/security/verifyGoogleMarketingInvariants.ts && tsx scripts/security/verifyPasswordSecurityBoundary.ts && tsx scripts/automation/runQualityExecution.ts build scripts/automation/buildRuntimeReleaseManifest.ts",
    "build:raw": "vite build && node scripts/seo/prerender-public-routes.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --alias:vite=./server/runtime/viteProductionDisabled.ts --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js .quality",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/automation/runQualityExecution.ts test",
    "test:raw": "vitest run && node --test scripts/pr/*.test.mjs scripts/systemadmin/*.test.mjs scripts/security/validateSecurityAssessment.test.mjs && npm run privacy:evidence:preflight && npm run readme:check && npm run docs:hygiene:check && npm run frontend:architecture:check && npm run vocabulary:governance:check",
    "seo:prerender": "node scripts/seo/prerender-public-routes.mjs",
    "pr:production-preflight": "node scripts/pr/productionPreflight.mjs",
    "pr:validate-claim": "node scripts/pr/validateWorkClaim.mjs",
    "pr:validate-template": "node scripts/pr/validatePrBody.mjs",
    "pr:workflow-security": "node scripts/security/verifyChangedWorkflowSecurity.mjs",
    "pr:governance:test": "node --test scripts/pr/*.test.mjs",
    "privacy:evidence:preflight": "node scripts/governance/verifyVendorPrivacyEvidence.mjs",
    "privacy:evidence:verify": "node scripts/governance/verifyVendorPrivacyEvidence.mjs --strict",
    "repository:validate": "tsx scripts/automation/validateRepositoryConventions.ts",
    "repository:validate:advisory": "tsx scripts/automation/validateRepositoryConventions.ts --advisory",
    "repository:quality:check": "tsx scripts/automation/validateRepositoryQuality.ts",
    "repository:quality:snapshot": "tsx scripts/automation/buildQualityCenterSnapshot.ts",
    "frontend:architecture:check": "tsx scripts/automation/validateFrontendArchitecture.ts",
    "status:scan-drift": "tsx scripts/automation/scanStatusEventDrift.ts",
    "hygiene:sweep": "tsx scripts/automation/sweepDocumentaryBranding.ts",
    "docs:hygiene:check": "tsx scripts/automation/validateDocumentationHygiene.ts",
    "vocabulary:wording:test": "vitest run src/platform/Vocabulary/Tests/vocabularyRegistry.test.ts src/platform/Vocabulary/Tests/uiMessageCatalog.test.ts src/platform/Vocabulary/Tests/fintechWordingBindings.test.ts src/platform/Vocabulary/Tests/wordingUsageIndex.test.ts src/platform/Vocabulary/Tests/messageDeliveryAdapter.test.ts src/platform/Vocabulary/Tests/vocabularyGovernanceProjection.test.ts src/platform/Vocabulary/Tests/vocabularyWikiProjection.test.ts src/platform/Vocabulary/Tests/wordingMigrationPlan.test.ts",
    "vocabulary:wording:check": "tsx scripts/automation/validateVocabularyWordingGovernance.ts",
    "vocabulary:wiki:check": "tsx scripts/automation/renderVocabularyWiki.ts --check",
    "vocabulary:wiki:render": "tsx scripts/automation/renderVocabularyWiki.ts --write",
    "vocabulary:wiki:sync": "tsx scripts/automation/syncVocabularyWiki.ts",
    "vocabulary:migration:check": "tsx scripts/automation/validateWordingMigration.ts",
    "vocabulary:closure:check": "tsx scripts/automation/validateVocabularyGovernanceClosure.ts",
    "vocabulary:governance:check": "npm run vocabulary:wording:check && npm run vocabulary:wiki:check && npm run vocabulary:migration:check && npm run vocabulary:closure:check",
    "vocabulary:governance:prepr": "npm run vocabulary:wording:test && npm run vocabulary:governance:check && npm run docs:hygiene:check && npm run repository:quality:check",
    "documentary:maintenance": "tsx scripts/automation/runDocumentaryMaintenanceControlLoop.ts",
    "documentary:maintenance:test": "vitest run tests/unit/archiveRetentionAgent.test.ts tests/unit/documentaryArchiveIntegrity.test.ts tests/unit/documentaryVersionIntegrity.test.ts tests/unit/documentarySemanticFreshness.test.ts tests/unit/documentaryMaintenanceAgent.test.ts tests/unit/documentaryMaintenanceOrchestrator.test.ts tests/unit/documentaryMaintenanceGitHost.test.ts tests/unit/documentaryMaintenanceObservability.test.ts",
    "documentary:maintenance:validate": "node scripts/automation/validateDocumentaryMaintenanceControlLoop.mjs",
    "documentary:maintenance:prepr": "npm run documentary:maintenance:test && npm run lint && npm run docs:hygiene:check && npm run documentary:version:verify && npm run documentary:archive:verify && npm run governance:control-plane && npm run repository:quality:check && npm run documentary:maintenance:validate",
    "sandbox:policy:test": "node --test scripts/automation/chatGptSandboxPolicy.test.mjs",
    "sandbox:prepr": "node scripts/automation/runChatGptSandboxPrePr.mjs",
    "sandbox:prepr:full": "node scripts/automation/runChatGptSandboxPrePr.mjs --full",
    "governance:control-plane": "node scripts/governance/validateGovernanceControlPlane.mjs",
    "predeploy:check": "tsx scripts/security/verifyGoogleMarketingInvariants.ts && tsx scripts/security/verifyPasswordSecurityBoundary.ts && tsx scripts/automation/verifyDeploymentReadiness.ts && npm run supplychain:provenance && npm run supplychain:verify",
    "release:version": "tsx scripts/automation/releaseVersion.ts",
    "release:manifest": "tsx scripts/automation/buildRuntimeReleaseManifest.ts",
    "readme:sync": "tsx scripts/automation/syncReadmeVersions.ts",
    "readme:check": "tsx scripts/automation/syncReadmeVersions.ts --check",
    "supplychain:provenance": "tsx scripts/automation/buildSupplyChainProvenance.ts",
    "supplychain:verify": "tsx scripts/security/verifySupplyChainProvenance.ts",
    "traceability:build": "tsx src/platform/Traceability/Services/runTraceability.ts",
    "rag:build-index": "tsx scripts/automation/buildRagIndex.ts",
    "governance:shadow-adr": "node scripts/governance/shadowAdrMetadataValidator.mjs",
    "governance:score": "node scripts/governance/weeklyGovernanceScore.mjs",
    "documentary:impact:plan": "tsx scripts/automation/planDocumentaryChangeImpact.ts",
    "documentary:autosync:plan": "tsx scripts/automation/planDocumentaryAutoSync.ts",
    "documentary:handoff:build": "tsx scripts/automation/buildDocumentaryMaintenanceHandoff.ts",
    "documentary:convergence:evidence": "tsx scripts/automation/buildDocumentaryConvergenceEvidence.ts",
    "documentary:archive:verify": "tsx scripts/automation/verifyDocumentaryArchiveIntegrity.ts",
    "documentary:version:verify": "node scripts/automation/verifyDocumentaryVersionIntegrity.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@duneanalytics/client-sdk": "0.4.3",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^6.1.1",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.1",
    "openai": "^7.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.17",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
