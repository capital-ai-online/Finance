{
  "name": "capital-ai",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsx scripts/security/verifyGoogleMarketingInvariants.ts && vite build && node scripts/seo/prerender-public-routes.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && tsx scripts/automation/buildRuntimeReleaseManifest.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run && node --test scripts/pr/*.test.mjs scripts/systemadmin/*.test.mjs && npm run privacy:evidence:preflight",
    "seo:prerender": "node scripts/seo/prerender-public-routes.mjs",
    "pr:production-preflight": "node scripts/pr/productionPreflight.mjs",
    "pr:validate-claim": "node scripts/pr/validateWorkClaim.mjs",
    "pr:validate-template": "node scripts/pr/validatePrBody.mjs",
    "pr:workflow-security": "node scripts/security/verifyChangedWorkflowSecurity.mjs",
    "pr:governance:test": "node --test scripts/pr/*.test.mjs",
    "privacy:evidence:preflight": "node scripts/governance/verifyVendorPrivacyEvidence.mjs",
    "privacy:evidence:verify": "node scripts/governance/verifyVendorPrivacyEvidence.mjs --strict",
    "repository:validate": "tsx scripts/automation/validateRepositoryConventions.ts",
    "repository:validate:advisory": "tsx scripts/automation/validateRepositoryConventions.ts --advisory",
    "status:scan-drift": "tsx scripts/automation/scanStatusEventDrift.ts",
    "hygiene:sweep": "tsx scripts/automation/sweepDocumentaryBranding.ts",
    "predeploy:check": "tsx scripts/security/verifyGoogleMarketingInvariants.ts && tsx scripts/automation/verifyDeploymentReadiness.ts && npm run supplychain:provenance && npm run supplychain:verify",
    "release:version": "tsx scripts/automation/releaseVersion.ts",
    "release:manifest": "tsx scripts/automation/buildRuntimeReleaseManifest.ts",
    "supplychain:provenance": "tsx scripts/automation/buildSupplyChainProvenance.ts",
    "supplychain:verify": "tsx scripts/security/verifySupplyChainProvenance.ts",
    "traceability:build": "tsx src/platform/Traceability/Services/runTraceability.ts",
    "rag:build-index": "tsx scripts/automation/buildRagIndex.ts",
    "governance:shadow-adr": "node scripts/governance/shadowAdrMetadataValidator.mjs",
    "governance:score": "node scripts/governance/weeklyGovernanceScore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "kraken-api": "^1.0.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^7.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^6.4.17",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
