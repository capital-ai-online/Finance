{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-ai.local/schemas/security-assessment.schema.json",
  "title": "CAPITAL-AI Security Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assessmentId", "authorization", "target", "scope", "pvcAssessments", "findings", "overallStatus"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assessmentId": { "type": "string", "minLength": 1 },
    "assessmentDate": { "type": "string", "format": "date-time" },
    "assessor": { "type": "string", "minLength": 1 },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "status", "authorizedTargets", "allowedTestClasses", "productionInScope"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "status": { "enum": ["AUTHORIZED", "NOT_AUTHORIZED", "EXPIRED", "REVOKED"] },
        "authorizedTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "allowedTestClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/assessmentMode" } },
        "productionInScope": { "type": "boolean" },
        "validFrom": { "type": ["string", "null"], "format": "date-time" },
        "validUntil": { "type": ["string", "null"], "format": "date-time" },
        "prohibitedTechniques": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "environment", "snapshot"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "snapshot": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "assessmentOnly"],
      "properties": {
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/assessmentMode" } },
        "assessmentOnly": { "const": true },
        "notes": { "type": "string" }
      }
    },
    "pvcAssessments": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "$ref": "#/$defs/pvcAssessment" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "overallStatus": { "enum": ["PASS", "PARTIAL", "FAIL", "NOT_TESTED"] },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "assessmentMode": { "enum": ["web-blackbox", "web-authz", "injection", "mobile-attack-surface", "smartphone-injection", "business-logic", "value-chain-attack"] },
    "pvcId": { "enum": ["PVC-01", "PVC-02", "PVC-03", "PVC-04", "PVC-05", "PVC-06", "PVC-07", "PVC-08", "PVC-09", "PVC-10", "PVC-11", "PVC-12", "PVC-13", "PVC-14", "PVC-15", "PVC-16", "PVC-17", "PVC-18"] },
    "primaryOwner": { "enum": ["CAPITAL-AI-CLIENT", "CAPITAL-AI-OPS", "CAPITAL-AI-DOC", "CAPITAL-AI-GOV", "CAPITAL-AI-DATA", "CAPITAL-AI-FINTECH"] },
    "resistanceState": { "enum": ["NOT_TESTED", "PASS", "PARTIAL", "FAIL", "NOT_APPLICABLE"] },
    "resistanceDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidenceRefs"],
      "properties": {
        "state": { "$ref": "#/$defs/resistanceState" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "PASS" } }, "required": ["state"] }, "then": { "properties": { "evidenceRefs": { "minItems": 1 } } } },
        { "if": { "properties": { "state": { "const": "NOT_APPLICABLE" } }, "required": ["state"] }, "then": { "required": ["reason"] } }
      ]
    },
    "pvcAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pvc", "primaryOwner", "blackboxResistance", "injectionResistance", "mobileResistance", "authenticationResistance", "authorizationResistance", "businessLogicAbuseResistance", "dataIntegrityUnderAttack", "boundaryBypassResistance", "detectionTraceability", "recoveryContainment", "evidenceQuality", "overallAdversarialMaturity"],
      "properties": {
        "pvc": { "$ref": "#/$defs/pvcId" },
        "primaryOwner": { "$ref": "#/$defs/primaryOwner" },
        "blackboxResistance": { "$ref": "#/$defs/resistanceDimension" },
        "injectionResistance": { "$ref": "#/$defs/resistanceDimension" },
        "mobileResistance": { "$ref": "#/$defs/resistanceDimension" },
        "authenticationResistance": { "$ref": "#/$defs/resistanceDimension" },
        "authorizationResistance": { "$ref": "#/$defs/resistanceDimension" },
        "businessLogicAbuseResistance": { "$ref": "#/$defs/resistanceDimension" },
        "dataIntegrityUnderAttack": { "$ref": "#/$defs/resistanceDimension" },
        "boundaryBypassResistance": { "$ref": "#/$defs/resistanceDimension" },
        "detectionTraceability": { "$ref": "#/$defs/resistanceDimension" },
        "recoveryContainment": { "$ref": "#/$defs/resistanceDimension" },
        "evidenceQuality": { "$ref": "#/$defs/resistanceDimension" },
        "overallAdversarialMaturity": { "$ref": "#/$defs/resistanceDimension" }
      }
    },
    "findingState": { "enum": ["NOT_TESTED", "TESTED_NO_FINDING", "CANDIDATE_FINDING", "CONFIRMED_FINDING", "REMEDIATION_REQUIRED", "EVIDENCE_READY", "VERIFIED", "ACCEPTED_RISK"] },
    "severity": { "enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "securityRemediationClass": { "enum": ["dependency-patch", "input-validation", "parser-hardening", "fail-closed-guard", "security-negative-tests", "auth-hardening", "secret-protection", "security-headers", "resource-limits", "supply-chain-hardening", "workflow-security", "runtime-security-config", "remove-unsafe-component", "security-evidence"] },
    "boundedSecurityRemediationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlId", "primaryPurpose", "confirmedSecurityFinding", "boundedSlice", "preservesDomainContracts", "affectedPaths", "changeClasses", "changesBusinessSemantics", "changesProductivePvcOwnership", "changesForeignAuthority", "protectedExternalMutationRequired", "weakensSecurityGates", "createsParallelControlPlane"],
      "properties": {
        "controlId": { "const": "CTRL-SEC-BOUNDED-REMEDIATION-001" },
        "primaryPurpose": { "const": "SECURITY_REMEDIATION" },
        "confirmedSecurityFinding": { "const": true },
        "boundedSlice": { "const": true },
        "preservesDomainContracts": { "const": true },
        "affectedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "changeClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/securityRemediationClass" } },
        "changesBusinessSemantics": { "const": false },
        "changesProductivePvcOwnership": { "const": false },
        "changesForeignAuthority": { "const": false },
        "protectedExternalMutationRequired": { "const": false },
        "weakensSecurityGates": { "const": false },
        "createsParallelControlPlane": { "const": false },
        "ownerDependencyRef": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "title", "severity", "state", "mode", "pvc", "primaryOwner", "authorizationRef", "targetSnapshot", "securityRequirements", "expectedResult", "observedResult", "evidenceRefs", "reproduction", "verificationRequirement"],
      "properties": {
        "findingId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "state": { "$ref": "#/$defs/findingState" },
        "mode": { "$ref": "#/$defs/assessmentMode" },
        "pvc": { "$ref": "#/$defs/pvcId" },
        "primaryOwner": { "$ref": "#/$defs/primaryOwner" },
        "authorizationRef": { "type": "string", "minLength": 1 },
        "targetSnapshot": { "type": "string", "minLength": 1 },
        "securityRequirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "expectedResult": { "type": "string", "minLength": 1 },
        "observedResult": { "type": "string", "minLength": 1 },
        "impact": { "type": "string" },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reproduction": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "remediationRequirement": { "type": "string" },
        "verificationRequirement": { "type": "string", "minLength": 1 },
        "riskAcceptanceAuthorityRef": { "type": ["string", "null"] },
        "routingStatus": { "enum": ["LOCAL_SECURITY_SCOPE", "SECURITY_BOUNDED", "OWNER_ROUTED", "REFERRED_NOT_EXECUTED"] },
        "remediationDecision": { "$ref": "#/$defs/boundedSecurityRemediationDecision" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "enum": ["CONFIRMED_FINDING", "REMEDIATION_REQUIRED", "EVIDENCE_READY", "VERIFIED", "ACCEPTED_RISK"] } }, "required": ["state"] },
          "then": { "properties": { "evidenceRefs": { "minItems": 1 }, "reproduction": { "minItems": 1 } } }
        },
        { "if": { "properties": { "state": { "const": "ACCEPTED_RISK" } }, "required": ["state"] }, "then": { "required": ["riskAcceptanceAuthorityRef"] } },
        { "if": { "properties": { "routingStatus": { "const": "SECURITY_BOUNDED" } }, "required": ["routingStatus"] }, "then": { "required": ["remediationDecision"] } }
      ]
    }
  }
}
