{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capital-ai://contracts/development-chain-roadmap-block/v1",
  "title": "CAPITAL-AI DEVELOPMENT Chain Roadmap Block Contract",
  "description": "Non-authorizing execution projection for a canonical Roadmap block. Runtime authority remains in Owner-approved REM + IAM + trusted host.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "blockId",
    "roadmapPath",
    "roadmapItem",
    "roadmapBaselineSha",
    "authorityRefs",
    "executionUnits",
    "globalStopConditions",
    "nonDelegableActions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "contractId": { "type": "string", "pattern": "^DC-RB-[A-Z0-9][A-Z0-9._-]{3,95}$" },
    "blockId": { "type": "string", "minLength": 1 },
    "roadmapPath": { "const": "docs/roadmaps/DEVELOPMENT_CHAIN_ROADMAP.md" },
    "roadmapItem": { "type": "string", "minLength": 1 },
    "roadmapBaselineSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "executionUnits": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executionUnit" }
    },
    "globalStopConditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nonDelegableActions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "executionUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitId",
        "sequence",
        "dependsOn",
        "objective",
        "authorityRefs",
        "allowedPaths",
        "allowedCapabilities",
        "maxRiskClass",
        "allowedMutationClasses",
        "prCheckClass",
        "requiredPreflight",
        "implementationRequirements",
        "requiredTests",
        "requiredEvidence",
        "rollback",
        "prCheckpoint",
        "resumeGate"
      ],
      "properties": {
        "unitId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,95}$" },
        "sequence": { "type": "integer", "minimum": 1 },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "objective": { "type": "string", "minLength": 1 },
        "authorityRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["READ", "ANALYZE", "PLAN", "BRANCH", "COMMIT", "PR", "CI_REQUEST"]
          }
        },
        "maxRiskClass": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "allowedMutationClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["REPOSITORY", "NON_PRODUCTION_CONFIG"] }
        },
        "prCheckClass": { "enum": ["D", "C", "R"] },
        "requiredPreflight": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "implementationRequirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredTests": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rollback": { "type": "string", "minLength": 1 },
        "prCheckpoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "stopAfterPullRequest", "mergeAuthority"],
          "properties": {
            "required": { "const": true },
            "stopAfterPullRequest": { "const": true },
            "mergeAuthority": { "const": "HUMAN_OWNER_ONLY" }
          }
        },
        "resumeGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "previousPrMerged",
            "previousBranchDeleted",
            "currentMainContainsPreviousMerge",
            "remStillValid",
            "roadmapStillUnblocked",
            "noOpenPrOverlap",
            "auditAvailable"
          ],
          "properties": {
            "previousPrMerged": { "const": true },
            "previousBranchDeleted": { "const": true },
            "currentMainContainsPreviousMerge": { "const": true },
            "remStillValid": { "const": true },
            "roadmapStillUnblocked": { "const": true },
            "noOpenPrOverlap": { "const": true },
            "auditAvailable": { "const": true }
          }
        }
      }
    }
  }
}
