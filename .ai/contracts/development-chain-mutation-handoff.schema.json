{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-ai.online/schemas/development-chain-mutation-handoff.schema.json",
  "title": "CAPITAL-AI DEVELOPMENT Chain Mutation Handoff",
  "description": "Non-authorizing, bounded work-order contract for DevelopmentChain mutation execution. Authorization remains in Roadmap/ADR/ESS, Human/Owner approval, REM/IAM, execution-host policy and durable audit evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractVersion",
    "status",
    "roadmapPhase",
    "roadmapItem",
    "repository",
    "baseBranch",
    "baseSha",
    "owner",
    "executorAgentId",
    "authorityRefs",
    "platform",
    "mutationClass",
    "riskClass",
    "targetResource",
    "allowedOperations",
    "forbiddenOperations",
    "expectedPostState",
    "idempotencyKey",
    "concurrencyKey",
    "preMutationChecks",
    "postMutationChecks",
    "negativeChecks",
    "rollbackPlan",
    "evidencePath",
    "auditRequired",
    "dryRunRequired",
    "expiresAt"
  ],
  "properties": {
    "contractId": {
      "type": "string",
      "pattern": "^DCH-[A-Z0-9][A-Z0-9._-]{2,80}$"
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ROADMAP_APPROVED",
        "PRECHECK_PASS",
        "MUTATION_APPROVED",
        "EXECUTING",
        "VERIFIED_PASS",
        "FAILED_ROLLBACK_REQUIRED",
        "ROLLED_BACK",
        "CANCELLED"
      ]
    },
    "roadmapPhase": {
      "type": "string",
      "pattern": "^M(?:[0-9]+|5A)$"
    },
    "roadmapItem": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "repository": {
      "const": "SvenKulessa/Finance"
    },
    "baseBranch": {
      "const": "main"
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "owner": {
      "const": "SvenKulessa"
    },
    "executorAgentId": {
      "const": "capital-ai-systemadmin-roadmap-executor"
    },
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 240
      }
    },
    "approvalEvidenceRef": {
      "type": ["string", "null"],
      "minLength": 3,
      "maxLength": 300
    },
    "platform": {
      "type": "string",
      "enum": ["GITHUB", "SUPABASE", "STRIPE", "RENDER", "IONOS", "OTHER"]
    },
    "mutationClass": {
      "type": "string",
      "enum": [
        "REPOSITORY",
        "PLATFORM_CONFIG",
        "IDENTITY",
        "DEPLOYMENT",
        "BILLING",
        "DATA",
        "DNS_TLS"
      ]
    },
    "riskClass": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
    },
    "targetResource": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "not": {
        "pattern": "(^|[/.:])\\*($|[/.:])"
      }
    },
    "allowedOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_:-]{2,180}$"
      }
    },
    "forbiddenOperations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_:-]{2,180}$"
      },
      "allOf": [
        {
          "contains": {"const": "MERGE"}
        },
        {
          "contains": {"const": "SELF_AUTHORITY_EXPANSION"}
        },
        {
          "contains": {"const": "SECURITY_CONTROL_DISABLEMENT"}
        }
      ]
    },
    "expectedPostState": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,180}$"
    },
    "concurrencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{5,180}$"
    },
    "preMutationChecks": {
      "$ref": "#/$defs/checkList"
    },
    "postMutationChecks": {
      "$ref": "#/$defs/checkList"
    },
    "negativeChecks": {
      "$ref": "#/$defs/checkList"
    },
    "rollbackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "procedureRef", "verification"],
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "procedureRef": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "verification": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        }
      }
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^docs/evidence/[^\\s]+$"
    },
    "auditRequired": {
      "const": true
    },
    "dryRunRequired": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "checkList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "MUTATION_APPROVED",
              "EXECUTING",
              "VERIFIED_PASS",
              "FAILED_ROLLBACK_REQUIRED",
              "ROLLED_BACK"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["approvalEvidenceRef"],
        "properties": {
          "approvalEvidenceRef": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    {
      "not": {
        "properties": {
          "allowedOperations": {
            "contains": {
              "enum": [
                "MERGE",
                "SELF_AUTHORITY_EXPANSION",
                "SECURITY_CONTROL_DISABLEMENT",
                "OWNER_ADMIN_ELEVATION",
                "SECRET_DISCLOSURE"
              ]
            }
          }
        },
        "required": ["allowedOperations"]
      }
    }
  ]
}
