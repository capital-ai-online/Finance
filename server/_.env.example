# Secondary server env example — synchronized with the canonical root template.
# Real secrets belong only in Render finance-secrets.env; never commit them.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APP_URL="MY_APP_URL"

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."
STRIPE_PRICE_ID_STARTER_YEARLY="price_..."
STRIPE_PRICE_ID_PRO_YEARLY="price_..."

# Existing provider keys
ALPHA_VANTAGE_KEY=
COIN_API_KEY=
EODHD_API_KEY=
TWELVEDATA_API_KEY=
FRED_API_KEY=
FMP_API_KEY=

# SC-4 Dune — DUNE_API_KEY lives in finance-secrets.env.
DUNE_API_KEY=
DUNE_ACCESS_MODE=FREE_TIER
DUNE_FREE_TIER_ATTESTED=false
DUNE_TRIAL_ATTESTED=false
DUNE_TRIAL_STARTED_AT=
DUNE_TRIAL_ENDS_AT=
DUNE_QUERY_AAVE_ACTIVE_ADDRESSES=5833540
DUNE_QUERY_AAVE_TREASURY=27230
DUNE_QUERY_AAVE_ORACLE_RAW=
DUNE_QUERY_AAVE_ADDRESS_RETENTION=
DUNE_QUERY_AAVE_TOKEN_EMISSIONS=
DUNE_QUERY_AAVE_LP_CONCENTRATION=
DUNE_MAX_RESULT_ROWS=25

# Primary keyless crypto suppliers: Binance Public + Kraken Public.
# Keyless specialist sources: GoPlus Free, GDELT DOC 2.0, DEX Screener,
# Sourcify v2 and DeFiLlama public API.
DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true

# NEWS_API_KEY / COINGLASS_API_KEY / LUNARCRUSH_API_KEY / MESSARI_API_KEY are intentionally unused.

TOTP_ENCRYPTION_KEY=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"

# Alpaca Market Data (server-side read-only Shadow Mode)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
