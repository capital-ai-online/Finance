
# ANTHROPIC_API_KEY / OPENAI_API_KEY (J3, J4): zusaetzliche Provider fuer den Modell-Rueckfall
# (agentModelRouting.ts) und - fuer OPENAI_API_KEY - fuer die RAG-Embeddings
# (src/services/rag/embeddingsClient.ts, `npm run rag:build-index`). Beide optional; ohne sie
# bleibt die jeweilige Stufe fail-open inaktiv.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Integration Variables
# NOTE: VITE_* environment variables are baked in by Vite at BUILD-TIME (e.g., during Render or Docker builds) and are NOT dynamically injected at runtime. Make sure to define these in the builder environment.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_pub_..."
VITE_SUPABASE_ANON_KEY="sb_anon_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_SERVICE_ROLE_KEY="sb_service_role_..."

# Stripe Integration Variables
STRIPE_SECRET_KEY="sk_test_..."
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs for Subscription Tiers
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."
STRIPE_PRICE_ID_ENTERPRISE="price_..."

# Jahres-Preise pro Plan (enthalten den Jahresrabatt bereits im Betrag -
# siehe server/stripe.ts. Keine zusätzliche Coupon-Variable nötig, ADR-0017)
STRIPE_PRICE_ID_STARTER_YEARLY="price_..."
STRIPE_PRICE_ID_PRO_YEARLY="price_..."

# Alpha Vantage API Key
ALPHA_VANTAGE_KEY=

# News API Key (NewsAPI.org or dynamic simulation key)
NEWS_API_KEY=

# ORCHESTRATOR_ADMIN_TOKEN wurde entfernt (ADR-0003.5): der Token+Hardcoded-Fallback-
# Mechanismus, den diese Variable steuerte, ist durch die einheitliche JWT-basierte
# checkAdminAccess()-Prüfung ersetzt worden. Kein Ersatzwert nötig.

# TOTP-Verschlüsselung (ADR-0003.5 Step-Up-Authentication)
# 32 Byte / 64 Hex-Zeichen. Generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WICHTIG: Ohne diesen Wert schlägt jede TOTP-Verschlüsselung/-Entschlüsselung fehl (fail-closed).
# Bei Rotation dieses Schlüssels werden bestehende TOTP-Secrets unlesbar - betroffene Nutzer
# müssen 2FA neu einrichten.
TOTP_ENCRYPTION_KEY=

# SMTP (support@capital-ai.online) - fuer System-E-Mails wie Abo-Aktivierungs-Bestätigungen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=support@capital-ai.online
SMTP_PASSWORD=
SMTP_FROM="CAPITAL-AI <support@capital-ai.online>"


# Alpaca Market Data (server-side, read-only Shadow Mode)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex
