  "valueChainIntegration": {
    "authority": "SC-MD-SPT-0001",
    "role": "read-only-wording-projection",
    "stageCoverage": 18,
    "runtimeStage": false,
    "financialDecisionAuthority": false,
    "mutationAuthority": false,
    "qualityProjectionCorrelation": "src/platform/Quality/ValueChain/FintechValueChainQualityProjection.ts"
  },
  "documentaryHandoff": {
    "snapshot": "Projection/VocabularyWordingSnapshot.ts",
    "consumer": "src/platform/Documentary/Knowledge/VocabularyWordingDocumentaryProjection.ts",
    "rule": "Vocabulary does not depend on Documentary; Documentary consumes the snapshot and reuses DocumentaryDocument, D7 Knowledge and DocumentaryTraceability contracts."
  },
  "wikiProjection": {
    "renderer": "Wiki/VocabularyWikiProjection.ts",
    "remotePolicy": "Wiki/VocabularyWikiRemotePolicy.ts",
    "renderCommand": "npm run vocabulary:wiki:render",
    "checkCommand": "npm run vocabulary:wiki:check",
    "syncCommand": "npm run vocabulary:wiki:sync",
    "defaultMode": "dry-run",
    "repositoryAuthoritative": false,
    "mutationAuthority": false,
    "publishRequires": [
      "--apply",
      "--push"
    ],
    "remotePolicyMode": "exact-github-allowlist-no-embedded-credentials"
  },
  "wordingMigration": {
    "plan": "Migration/WordingMigrationPlan.ts",
    "mode": "controlled-incremental",
    "automaticApplyAllowed": false,
    "blockingState": "DRIFT",
    "nonBlockingDebtState": "OPEN"
