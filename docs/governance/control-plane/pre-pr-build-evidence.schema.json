{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-ai.local/schemas/pre-pr-build-evidence.schema.json",
  "title": "CAPITAL-AI Pre-PR Build Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trustClass",
    "repository",
    "baseMainSha",
    "candidateHeadSha",
    "executor",
    "checks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "pre-pr-build/1.0.0"
    },
    "trustClass": {
      "const": "developer-preflight"
    },
    "repository": {
      "const": "SvenKulessa/Finance"
    },
    "baseMainSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateHeadSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "identity"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "identity": { "type": "string", "minLength": 1 },
        "environment": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "SKIPPED", "NOT_AVAILABLE"] },
          "durationMs": { "type": "integer", "minimum": 0 },
          "evidenceDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "note": { "type": "string" }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "aggregateEvidenceDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonAuthorizingStatement": {
      "const": "This evidence does not authorize PR creation, merge, deployment, production mutation or privilege elevation."
    }
  }
}