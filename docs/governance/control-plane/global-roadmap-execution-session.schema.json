{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-ai.local/governance/global-roadmap-execution-session.schema.json",
  "title": "CAPITAL-AI Global Roadmap Execution Session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "mode",
    "status",
    "authorizedBy",
    "reason",
    "activationMainSha",
    "roadmap",
    "documents",
    "targetProjects",
    "activatedAt",
    "expiresAt",
    "maxDurationHours",
    "chatBound",
    "repositoryMutationOnly",
    "exactPrApprovalRequired",
    "humanMergeRequired",
    "protectedExternalMutationSeparatelyApproved",
    "securityVerificationDelegated",
    "ownerTransfer"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "minLength": 1 },
    "mode": { "const": "GOV_GLOBAL_ROADMAP_SESSION" },
    "status": { "enum": ["proposed", "active", "completed", "revoked", "expired", "invalidated"] },
    "authorizedBy": { "const": "Human/Owner" },
    "reason": { "type": "string", "minLength": 1 },
    "activationMainSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "roadmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commitSha"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "targetProjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "projectFolder", "pvcStages", "workItems", "allowedPathPrefixes"],
        "properties": {
          "project": { "type": "string", "pattern": "^CAPITAL-AI-[A-Z0-9-]+$" },
          "projectFolder": { "type": "string", "pattern": "^docs/projects/[^/]+/$" },
          "pvcStages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^PVC-[0-9]{2}$" }
          },
          "workItems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "allowedPathPrefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "activatedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxDurationHours": { "const": 8 },
    "chatBound": { "const": true },
    "repositoryMutationOnly": { "const": true },
    "exactPrApprovalRequired": { "const": true },
    "humanMergeRequired": { "const": true },
    "protectedExternalMutationSeparatelyApproved": { "const": true },
    "securityVerificationDelegated": { "const": false },
    "ownerTransfer": { "const": false }
  }
}
