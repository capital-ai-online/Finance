{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "capital-ai-design-tokens",
  "version": "0.6.0-phase0",
  "description": "Formalized design tokens extracted from src/index.css @theme and FRONTEND_ARCH.md. Source of truth for Phase 0–1.",
  "color": {
    "background": { "value": "#18181b", "type": "color", "css": "--color-background" },
    "foreground": { "value": "#FFFFFF", "type": "color", "css": "--color-foreground" },
    "border": { "value": "rgba(255, 255, 255, 0.08)", "type": "color", "css": "--color-border" },
    "aif": {
      "gold": {
        "light": { "value": "#FFF2B2", "type": "color", "css": "--color-aif-gold-light" },
        "DEFAULT": { "value": "#F5C453", "type": "color", "css": "--color-aif-gold-DEFAULT" },
        "dark": { "value": "#D4A017", "type": "color", "css": "--color-aif-gold-dark" },
        "muted": { "value": "#8A640F", "type": "color", "css": "--color-aif-gold-muted" }
      },
      "neon": {
        "cyan": { "value": "#0DDDDD", "type": "color", "css": "--color-aif-neon-cyan" },
        "purple": { "value": "#B026FF", "type": "color", "css": "--color-aif-neon-purple" }
      }
    },
    "semantic": {
      "success": { "value": "#4ade80", "type": "color", "note": "text-green-400 — validated / READY" },
      "danger": { "value": "#f87171", "type": "color", "note": "text-red-400 — REJECT / error" },
      "warning": { "value": "#fbbf24", "type": "color", "note": "text-amber-400 — observe / partial" },
      "info": { "value": "#0DDDDD", "type": "color", "note": "neon cyan — live / info" },
      "muted": { "value": "rgba(255,255,255,0.45)", "type": "color", "note": "secondary text" },
      "status": {
        "ready": { "value": "#4ade80", "type": "color" },
        "reject": { "value": "#f87171", "type": "color" },
        "dataUnavailable": { "value": "rgba(255,255,255,0.35)", "type": "color" },
        "observe": { "value": "#fbbf24", "type": "color" }
      }
    },
    "surface": {
      "glass": { "value": "rgba(10, 10, 10, 0.4)", "type": "color", "note": "bg-neutral-950/40" },
      "elevated": { "value": "rgba(24, 24, 27, 0.85)", "type": "color" }
    }
  },
  "font": {
    "sans": { "value": "\"Poppins\", ui-sans-serif, system-ui, sans-serif", "css": "--font-sans" },
    "display": { "value": "\"Montserrat\", ui-sans-serif, system-ui, sans-serif", "css": "--font-display" },
    "mono": { "value": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, monospace", "css": "--font-mono" }
  },
  "fontSize": {
    "xs": { "value": "0.75rem" },
    "sm": { "value": "0.875rem" },
    "base": { "value": "1rem" },
    "lg": { "value": "1.125rem" },
    "xl": { "value": "1.25rem" },
    "2xl": { "value": "1.5rem" },
    "3xl": { "value": "1.875rem" }
  },
  "spacing": {
    "0": { "value": "0" },
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "5": { "value": "1.25rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" },
    "card": { "value": "1.5rem", "note": "p-6 default card padding" },
    "section": { "value": "2rem", "note": "recommended inter-card gap (Phase 1 whitespace)" }
  },
  "radius": {
    "sm": { "value": "0.375rem" },
    "md": { "value": "0.5rem" },
    "lg": { "value": "0.75rem" },
    "xl": { "value": "0.75rem", "note": "rounded-xl — primary card" },
    "2xl": { "value": "1rem" },
    "full": { "value": "9999px" }
  },
  "shadow": {
    "glass": { "value": "0 0 0 1px rgba(255,255,255,0.08)" },
    "goldGlow": { "value": "0 0 20px rgba(245, 196, 83, 0.8)" },
    "cyanGlow": { "value": "0 0 15px rgba(13, 221, 221, 1)" },
    "brandPulse": {
      "value": "0 0 25px rgba(245, 196, 83, 0.25), 0 0 35px rgba(13, 221, 221, 0.15), 0 0 35px rgba(176, 38, 255, 0.15)"
    }
  },
  "motion": {
    "duration": {
      "fast": { "value": "0.2s", "note": "exit / snappy" },
      "base": { "value": "0.3s" },
      "slow": { "value": "0.5s" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.4, 0, 0.6, 1)" }
    },
    "animation": {
      "neuralPulse": { "value": "neuralPulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite" },
      "neuralPulseFast": { "value": "neuralPulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite" },
      "goldShimmer": { "value": "goldShimmer 8s linear infinite" },
      "goldPulse": { "value": "goldPulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite" }
    }
  },
  "accessibility": {
    "focusRing": {
      "color": { "value": "#F5C453" },
      "width": { "value": "2px" },
      "offset": { "value": "4px" }
    },
    "minHitTarget": { "value": "44px", "note": "BFSG / EN 301 549" },
    "reducedMotion": { "value": "respect prefers-reduced-motion" }
  },
  "patterns": {
    "glassCard": {
      "class": "bg-neutral-950/40 border border-white/10 backdrop-blur-md rounded-xl p-6"
    }
  }
}
