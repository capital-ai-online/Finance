# CAPITAL-AI Extended Crypto Evidence provider configuration
# 2026-08-22 — server-side/runtime configuration only.
# No real credentials belong in this repository and no provider secret may use a VITE_* prefix.

# Primary crypto market/derivatives suppliers — keyless public endpoints.
# Exact venue symbols are still governed by CryptoEvidenceIdentityRegistry; no symbol guessing.
# - Binance Public Spot/Futures
# - Kraken Public/Futures

# GoPlus Security — OPTIONAL token. Canonical baseline is keyless/free.
GOPLUS_API_KEY=

# Dune — API key is stored only in finance-secrets.env.
DUNE_API_KEY=
# Access modes: FREE_TIER or TRIAL_14D.
# The Owner reported a 14-day entitlement to the fuller Dune dataset surface. Public Dune docs
# did not independently expose that exact trial term during the 2026-08-22 review, so TRIAL_14D
# requires explicit Owner attestation and timestamps and fails closed automatically at expiry.
DUNE_ACCESS_MODE=FREE_TIER
DUNE_FREE_TIER_ATTESTED=false
DUNE_TRIAL_ATTESTED=false
DUNE_TRIAL_STARTED_AT=
DUNE_TRIAL_ENDS_AT=
# Only reviewed saved query IDs. Trial mode broadens dataset entitlement, NOT runtime authority:
# arbitrary SQL, execute-query, pipelines and model/user-provided query IDs remain forbidden.
# 27230   = Owner-attested Aave/Ethereum Treasury Value Over Time; expected: observed_at,treasury_usd
# 5833540 = Owner-attested Aave/Ethereum Active Addresses; expected: observed_at,active_addresses
# Runtime schema validation remains mandatory before VERIFIED evidence is emitted.
DUNE_ALLOWED_QUERY_IDS=27230,5833540
DUNE_MAX_RESULT_ROWS=25

# Pending Dune custom-query work; NOT allowlisted until an actual saved-query ID exists:
# - Aave V3 / Ethereum / Oracle Raw Data
#   required minimum: observed_at,asset,oracle_price,oracle_address,oracle_updated_at,oracle_decimals
# - Aave / Ethereum / Address Retention
#   required: observed_at,cohort_start,cohort_end,return_window_start,return_window_end,
#             cohort_addresses,retained_addresses,retention_rate

# Keyless/free active providers — no secret configuration required:
# - Binance Public Spot/Futures: primary crypto market/derivatives evidence
# - Kraken Public/Futures: primary crypto market/derivatives evidence
# - GDELT DOC 2.0: article metadata / source links
# - DEX Screener public API: DEX pool/liquidity/activity evidence
# - Sourcify API v2: EVM source/bytecode verification
# - DeFiLlama public API: canonical DeFi TVL/fees/revenue evidence
DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true

# Gemini Research Shadow is governed by ADR-0090 and uses the existing GEMINI_API_KEY.
# A second key in the SAME Google Cloud project does not add quota because Gemini rate limits are
# project-scoped, not key-scoped. Do not add a second key merely to multiply Free-Tier capacity.
# A separate project would require a separate governance/privacy/quota decision.

# Explicitly NOT USED in this free-evidence architecture:
# NEWS_API_KEY, COINGLASS_API_KEY, LUNARCRUSH_API_KEY, MESSARI_API_KEY
