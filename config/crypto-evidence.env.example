# CAPITAL-AI Extended Crypto Evidence provider configuration
# 2026-08-22 — server-side/runtime configuration only.
#
# Active evidence defaults are free/keyless except Dune, which requires a Free-Tier API key.
# No real credentials belong in this repository and no provider secret may use a VITE_* prefix.

# GoPlus Security — OPTIONAL. The canonical baseline is keyless/free and locally capped at the
# documented 30 calls/minute. Set a token only after a separate higher-quota approval.
GOPLUS_API_KEY=

# Dune — FREE-TIER-ONLY. The adapter will not call Dune until the Owner has manually confirmed
# the account is on the Free plan and set DUNE_FREE_TIER_ATTESTED=true.
DUNE_API_KEY=
DUNE_FREE_TIER_ONLY=true
DUNE_FREE_TIER_ATTESTED=false
# Only reviewed saved query IDs. No SQL/execute endpoint exists in the CAPITAL-AI provider.
DUNE_ALLOWED_QUERY_IDS=
# Result-size guard; implementation clamps this to max 100 rows and requested columns only.
DUNE_MAX_RESULT_ROWS=25

# Keyless/free active providers — no secret configuration required:
# - GDELT DOC 2.0: article metadata / source links
# - Kraken Futures Public Charts: derivatives/market analytics for governed market symbols
# - DEX Screener public API: DEX pool/liquidity/activity evidence for governed token identities
# - Sourcify API v2: EVM source/bytecode verification lookup
# - DeFiLlama public API: current canonical DeFi TVL/fees/revenue evidence

DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true

# Explicitly NOT USED in this free-evidence architecture:
# NEWS_API_KEY, COINGLASS_API_KEY, LUNARCRUSH_API_KEY, MESSARI_API_KEY
