# CAPITAL-AI Extended Crypto Evidence provider configuration
# 2026-08-22 — server-side/runtime configuration only.
#
# This file is documentation only. Do not commit real credentials.
# Production secrets must be provisioned through the canonical finance-secrets.env process after
# the corresponding Owner/security approval. No provider key may use a VITE_* prefix.

# GoPlus Security: OPTIONAL for the public/free baseline. Configure only for an approved
# authenticated/higher-quota GoPlus package.
GOPLUS_API_KEY=

# Paid/entitlement-gated providers. Without a key the adapter remains NOT_CONFIGURED.
COINGLASS_API_KEY=
LUNARCRUSH_API_KEY=
MESSARI_API_KEY=
DUNE_API_KEY=
NEWS_API_KEY=

# Non-secret governance configuration: comma-separated Dune saved-query IDs approved by Owner.
# Arbitrary SQL and runtime/model-created queries are not supported.
DUNE_ALLOWED_QUERY_IDS=

# Existing DeFiLlama public evidence path remains keyless/free.
DEFILLAMA_PROVIDER_ENABLED=true
DEFILLAMA_EVIDENCE_ENABLED=true
